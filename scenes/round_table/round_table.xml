<mujoco model="round_table_reference">
  <compiler angle="degree"/>
  <option timestep="0.002">
    <!-- Multiple contacts stabilize flat-bottomed objects on the round tabletop. -->
    <flag nativeccd="enable" multiccd="enable"/>
  </option>
  <statistic center="0 0 0.65" extent="1.5"/>
  <visual>
    <global offwidth="960" offheight="720" azimuth="90" elevation="-35"/>
    <quality numslices="64" numstacks="32"/>
    <headlight diffuse="0.20 0.20 0.20" ambient="0.23 0.23 0.23" specular="0 0 0"/>
  </visual>

  <default>
    <geom friction="0.65 0.005 0.0001"/>
    <default class="visual">
      <geom contype="0" conaffinity="0" mass="0" group="2"/>
    </default>
    <default class="jar_wall">
      <geom type="box" size="0.012 0.003 0.040" density="550" rgba="0.56 0.57 0.58 0.82"/>
    </default>
  </default>

  <worldbody>
    <light name="key" pos="-1 -1.5 3" dir="0.3 0.4 -1" directional="true" diffuse="0.56 0.53 0.49"/>
    <light name="fill" pos="1 1 2.7" dir="-0.4 -0.4 -1" directional="true" diffuse="0.15 0.17 0.20" castshadow="false"/>
    <camera name="overview" pos="0 -1.85 1.94" xyaxes="1 0 0 0 0.57 0.82" fovy="37"/>
    <camera name="tabletop" pos="0 0 2.12" xyaxes="1 0 0 0 1 0" fovy="43"/>
    <geom name="floor" type="plane" size="0 0 0.05" rgba="0.31 0.33 0.35 1"/>

    <body name="round_table">
      <!-- The table diameter sets the approximate scene scale. The top is at Z = 0.75 m. -->
      <geom name="tabletop" type="cylinder" pos="0 0 0.733" size="0.50 0.017" rgba="0.77 0.66 0.51 1"/>
      <geom name="table_column" type="cylinder" pos="0 0 0.369" size="0.035 0.351" rgba="0.64 0.65 0.66 1"/>
      <geom name="table_foot" type="cylinder" pos="0 0 0.012" size="0.21 0.012" rgba="0.48 0.50 0.52 1"/>
    </body>

    <!-- XY positions are approximate, from the rectified 25 s video frame.
         Object body origins are at their bases, 1 mm above the table. -->
    <body name="bottle" pos="0.29 -0.09 0.751">
      <freejoint/>
      <geom name="bottle_body" type="cylinder" pos="0 0 0.070" size="0.034 0.070" density="170" rgba="0.72 0.83 0.86 0.60"/>
      <geom name="bottle_shoulder" type="ellipsoid" pos="0 0 0.135" size="0.034 0.034 0.046" density="80" rgba="0.72 0.83 0.86 0.60"/>
      <geom name="bottle_neck" type="cylinder" pos="0 0 0.181" size="0.012 0.018" density="350" rgba="0.72 0.83 0.86 0.60"/>
      <geom name="bottle_cap" type="cylinder" pos="0 0 0.207" size="0.017 0.013" density="550" rgba="0.78 0.075 0.09 1"/>
      <geom class="visual" type="cylinder" pos="0 0 0.079" size="0.0343 0.025" rgba="0.92 0.91 0.83 1"/>
      <geom class="visual" type="cylinder" pos="0 0 0.090" size="0.0345 0.010" rgba="0.19 0.46 0.50 1"/>
      <geom class="visual" type="cylinder" pos="0 0 0.066" size="0.0345 0.009" rgba="0.68 0.14 0.14 1"/>
    </body>

    <body name="jar" pos="0.10 -0.13 0.751">
      <freejoint/>
      <geom name="jar_base" type="cylinder" pos="0 0 0.008" size="0.046 0.008" density="700" rgba="0.47 0.46 0.45 1"/>
      <!-- Tangential boxes form the rim and leave the interior open to contacts. -->
      <geom class="jar_wall" pos="0 0.043 0.054"/>
      <geom class="jar_wall" pos="-0.0215 0.0372 0.054" euler="0 0 30"/>
      <geom class="jar_wall" pos="-0.0372 0.0215 0.054" euler="0 0 60"/>
      <geom class="jar_wall" pos="-0.043 0 0.054" euler="0 0 90"/>
      <geom class="jar_wall" pos="-0.0372 -0.0215 0.054" euler="0 0 120"/>
      <geom class="jar_wall" pos="-0.0215 -0.0372 0.054" euler="0 0 150"/>
      <geom class="jar_wall" pos="0 -0.043 0.054" euler="0 0 180"/>
      <geom class="jar_wall" pos="0.0215 -0.0372 0.054" euler="0 0 210"/>
      <geom class="jar_wall" pos="0.0372 -0.0215 0.054" euler="0 0 240"/>
      <geom class="jar_wall" pos="0.043 0 0.054" euler="0 0 270"/>
      <geom class="jar_wall" pos="0.0372 0.0215 0.054" euler="0 0 300"/>
      <geom class="jar_wall" pos="0.0215 0.0372 0.054" euler="0 0 330"/>
    </body>

    <body name="package" pos="0.14 0.05 0.751" euler="0 0 -21">
      <freejoint/>
      <geom name="package_body" type="box" pos="0 0 0.020" size="0.076 0.047 0.020" density="250" rgba="0.78 0.69 0.43 1"/>
      <geom class="visual" type="box" pos="0.001 -0.001 0.0405" size="0.063 0.039 0.001" rgba="0.95 0.94 0.88 1"/>
    </body>
  </worldbody>
</mujoco>
